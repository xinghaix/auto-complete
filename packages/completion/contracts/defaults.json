{
  "schemaVersion": 1,
  "enabled": true,
  "autoTrigger": true,
  "snoozeMinutes": 0,
  "showStatusBar": true,
  "uiTheme": "auto",
  "activeProfileId": "default",
  "profiles": [
    {
      "id": "default",
      "name": "Default",
      "provider": "openai-compatible",
      "baseUrl": "http://127.0.0.1:11434/v1",
      "model": "qwen2.5-coder:7b",
      "authHeaderTemplate": "Authorization: Bearer ${apiKey}",
      "extraHeadersJson": "{}",
      "fimPath": "",
      "chatPath": "/chat/completions",
      "completionsPath": "",
      "requestStyle": "AUTO",
      "promptTemplate": "AUTO",
      "temperature": 0,
      "maxTokens": 128,
      "timeoutMs": 3000,
      "settingsTimeoutMs": 15000,
      "stream": false,
      "overrideContextBudget": false,
      "maxPrefixChars": 8000,
      "maxSuffixChars": 2000,
      "hasApiKey": false
    }
  ],
  "enableInComments": true,
  "enableInStrings": true,
  "disabledLanguages": [],
  "firstLineOnlyWhenMidLine": true,
  "sendFilePath": true,
  "respectGitignore": true,
  "uiLocale": "auto",
  "ignoreGlobs": [
    "**/.git/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/target/**",
    "**/.idea/**",
    "**/.gradle/**",
    "**/vendor/**"
  ],
  "debounceMinMs": 150,
  "debounceInitialMs": 300,
  "debounceMaxMs": 1000,
  "maxPrefixChars": 8000,
  "maxSuffixChars": 2000,
  "maxInFlight": 1,
  "cacheSize": 20,
  "lruSize": 64,
  "maxFileSizeKb": 512,
  "enableRecentFileContext": false,
  "recentFileLimit": 3,
  "recentFileMaxChars": 1200,
  "logPromptBodies": false,
  "logLevel": "info",
  "logRetention": 1000,
  "notifyOnFatalError": true,
  "showCostApprox": false
}
