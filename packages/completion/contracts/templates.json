{
  "version": 1,
  "templates": [
    {
      "id": "AUTO",
      "shortLabel": "Auto",
      "wireFormat": "CHAT_MESSAGES",
      "probe": false,
      "stopTokens": [],
      "tokenPrompt": null
    },
    {
      "id": "CODESTRAL_API",
      "shortLabel": "(fim) OpenAI FIM",
      "wireFormat": "FIM_FIELDS",
      "probe": true,
      "stopTokens": [],
      "tokenPrompt": null,
      "defaultPath": "/fim/completions",
      "notes": "OpenAI-style FIM with JSON prompt + suffix fields. For DeepSeek Beta cloud FIM (https://api.deepseek.com/beta), default path resolves to /completions when fimPath is empty."
    },
    {
      "id": "QWEN",
      "shortLabel": "(fim) Qwen",
      "wireFormat": "COMPLETION_PROMPT",
      "probe": true,
      "stopTokens": [
        "<|endoftext|>",
        "<|fim_prefix|>",
        "<|fim_middle|>",
        "<|fim_suffix|>",
        "<|fim_pad|>",
        "<|repo_name|>",
        "<|file_sep|>",
        "<|im_end|>"
      ],
      "tokenPrompt": "<|fim_prefix|>{prefix}<|fim_suffix|>{suffix}<|fim_middle|>",
      "defaultPath": "/completions",
      "notes": "Covers Qwen2.5-Coder, Qwen3-Coder, CodeGemma, and CodeGeeX token FIM models."
    },
    {
      "id": "DEEPSEEK",
      "shortLabel": "(fim) DeepSeek",
      "wireFormat": "COMPLETION_PROMPT",
      "probe": true,
      "stopTokens": [
        "<｜fim▁begin｜>",
        "<｜fim▁hole｜>",
        "<｜fim▁end｜>",
        "<|EOT|>",
        "<｜end▁of▁sentence｜>"
      ],
      "tokenPrompt": "<｜fim▁begin｜>{prefix}<｜fim▁hole｜>{suffix}<｜fim▁end｜>",
      "defaultPath": "/completions",
      "notes": "Local/self-hosted DeepSeek Coder token FIM. Cloud DeepSeek Beta FIM (deepseek.com/beta) uses CODESTRAL_API with /completions."
    },
    {
      "id": "STARCODER",
      "shortLabel": "(fim) StarCoder",
      "wireFormat": "COMPLETION_PROMPT",
      "probe": true,
      "stopTokens": [
        "<|endoftext|>",
        "<fim_prefix>",
        "<fim_middle>",
        "<fim_suffix>",
        "<fim_pad>",
        "<file_sep>",
        "<|eos|>"
      ],
      "tokenPrompt": "<fim_prefix>{prefix}<fim_suffix>{suffix}<fim_middle>",
      "defaultPath": "/completions"
    },
    {
      "id": "CODELLAMA",
      "shortLabel": "(fim) CodeLlama",
      "wireFormat": "COMPLETION_PROMPT",
      "probe": true,
      "stopTokens": [
        "<EOT>",
        "<PRE>",
        "<SUF>",
        "<MID>",
        "</s>",
        "<|endoftext|>"
      ],
      "tokenPrompt": "<PRE>{prefix}<SUF>{suffix}<MID>",
      "defaultPath": "/completions",
      "notes": "Native CodeLlama infill tokens (<PRE>/<SUF>/<MID>)."
    },
    {
      "id": "CHAT",
      "shortLabel": "(chat) Pseudo-FIM",
      "wireFormat": "CHAT_MESSAGES",
      "probe": true,
      "stopTokens": [],
      "tokenPrompt": null,
      "defaultPath": "/chat/completions"
    },
    {
      "id": "RESPONSES",
      "shortLabel": "(responses) OpenAI Responses",
      "wireFormat": "RESPONSES_API",
      "probe": true,
      "stopTokens": [],
      "tokenPrompt": null,
      "defaultPath": "/responses",
      "notes": "Native OpenAI Responses API (POST /responses with instructions, input, max_output_tokens, store=false). Supports nested extraBodyJson such as {\"reasoning\":{\"effort\":\"none\"}}."
    }
  ],
  "baseUrlHints": [
    {
      "match": "deepseek.com/beta",
      "template": "CODESTRAL_API",
      "defaultFimPath": "/completions",
      "notes": "DeepSeek Beta cloud FIM API uses POST /beta/completions with JSON prompt + suffix."
    },
    {
      "match": "mistral.ai",
      "template": "CODESTRAL_API",
      "defaultFimPath": "/fim/completions",
      "notes": "Mistral / Codestral API uses FIM_FIELDS."
    }
  ],
  "detectionRules": [
    {
      "match": ["codestral", "mistral-code", "devstral"],
      "template": "CODESTRAL_API"
    },
    {
      "matchAll": ["deepseek"],
      "matchAny": ["coder", "code"],
      "template": "DEEPSEEK"
    },
    {
      "match": ["qwen3-coder", "qwen", "codegemma", "codegeex"],
      "template": "QWEN"
    },
    {
      "match": ["codellama", "code-llama"],
      "template": "CODELLAMA"
    },
    {
      "match": ["starcoder", "santacoder", "crystalcoder"],
      "template": "STARCODER"
    },
    {
      "match": ["gpt-", "claude", "chatgpt"],
      "matchRegex": ["(?:^|[-_/:])o[134](?:$|[-_.:])"],
      "template": "CHAT",
      "notes": "Word-boundary regex prevents matching demo1-coder or proto3-coder."
    },
    {
      "match": ["coder", "code-"],
      "matchEndsWith": ["-code"],
      "template": "QWEN"
    }
  ],
  "defaultTemplate": "CHAT",
  "chatSystemPrompt": "Task: Inline code completion (Fill-In-the-Middle). Output ONLY the exact raw code to insert at <|cursor|> inside <code>, staying syntactically valid in the immediate enclosing block, with no markdown fences, explanations, or unrelated code.",
  "chatUserTemplate": "Output ONLY the exact raw code to insert at <|cursor|>.\n<code>\n{prefix}<|cursor|>{suffix}\n</code>\nCompletion:\n",
  "probePrefix": "def add(a, b):\n    ",
  "probeSuffix": "\n"
}
