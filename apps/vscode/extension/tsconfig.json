{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "sourceMap": true,
    "noEmit": true,
    "paths": {
      "@auto-complete/core-ts": ["../../../packages/completion/engine-ts/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
